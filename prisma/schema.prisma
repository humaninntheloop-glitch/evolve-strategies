generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  EMPLOYEE
  REVIEWER
}

enum DistributionContext {
  INTERNAL
  EXTERNAL
}

enum AiOutputImpact {
  INTERNAL_NOTES
  INTERNAL_RESEARCH
  INTERNAL_DOCUMENT
  CLIENT_COMMUNICATION
  EXTERNAL_REPORTS
  FINANCIAL_LEGAL
  REGULATORY_COMPLIANCE
}

enum RiskLevel {
  LOW
  MODERATE
  HIGH
}

enum RecordStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  RECORDED
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  isDemo    Boolean  @default(false) @map("is_demo")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users          User[]
  records        Record[]
  auditLogs      AuditLog[]
  riskCategories RiskCategory[]
  apiKeys        ApiKey[]

  @@map("organizations")
}

model User {
  id             String       @id @db.Uuid
  email          String       @unique
  fullName       String       @map("full_name")
  role           UserRole     @default(EMPLOYEE)
  organizationId String       @map("organization_id") @db.Uuid
  isActive       Boolean      @default(true) @map("is_active")
  isSuperAdmin   Boolean      @default(false) @map("is_super_admin")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id])
  createdRecords Record[]     @relation("CreatedRecords")
  reviewedRecords Record[]    @relation("ReviewedRecords")
  auditLogs      AuditLog[]
  createdApiKeys ApiKey[]

  @@index([organizationId])
  @@map("users")
}

model Record {
  id                     String              @id @default(uuid()) @db.Uuid
  organizationId         String              @map("organization_id") @db.Uuid
  creatorId              String              @map("creator_id") @db.Uuid
  reviewerId             String?             @map("reviewer_id") @db.Uuid
  claimedAt              DateTime?           @map("claimed_at")
  intendedUseDescription String?             @map("intended_use_description")
  aiToolUsed             String[]            @default([]) @map("ai_tool_used") @db.Text
  aiToolUsedOther        String?             @map("ai_tool_used_other")
  distributionContext    DistributionContext? @map("distribution_context")
  dataSensitivity        Boolean             @map("data_sensitivity")
  highStakesDecision     Boolean?            @map("high_stakes_decision")
  aiJustification        String?             @map("ai_justification")
  aiOutputImpact         AiOutputImpact?     @map("ai_output_impact")
  aiUsageType            String[]            @default([]) @map("ai_usage_type") @db.Text
  aiUsageTypeOther       String?             @map("ai_usage_type_other")
  humanReviewPlan        String[]            @default([]) @map("human_review_plan") @db.Text
  humanReviewPlanOther   String?             @map("human_review_plan_other")
  aiUseJustification              String[]  @default([]) @map("ai_use_justification") @db.Text
  aiUseJustificationOther         String?   @map("ai_use_justification_other")
  reviewerDecisionRationale       String?   @map("reviewer_decision_rationale")
  reviewerDecisionRationaleOther  String?   @map("reviewer_decision_rationale_other")
  reviewerValidationReference     String[]  @default([]) @map("reviewer_validation_reference") @db.Text
  reviewerValidationReferenceOther String?  @map("reviewer_validation_reference_other")
  attachmentPath         String?             @map("attachment_path")
  attachmentName         String?             @map("attachment_name")
  attachmentSize         Int?                @map("attachment_size")
  attachmentType         String?             @map("attachment_type")
  aiSummary              String?             @map("ai_summary")
  riskLevel              RiskLevel?          @map("risk_level")
  riskJustification      String?             @map("risk_justification")
  status                 RecordStatus        @default(DRAFT)
  reviewComment          String?             @map("review_comment")
  submittedAt            DateTime?           @map("submitted_at")
  approvedAt             DateTime?           @map("approved_at")
  rejectedAt             DateTime?           @map("rejected_at")
  recordedAt             DateTime?           @map("recorded_at")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  creator      User         @relation("CreatedRecords", fields: [creatorId], references: [id])
  reviewer     User?        @relation("ReviewedRecords", fields: [reviewerId], references: [id])
  auditLogs    AuditLog[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([creatorId])
  @@map("records")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  recordId       String   @map("record_id") @db.Uuid
  actionType     String   @map("action_type")
  actorId        String   @map("actor_id") @db.Uuid
  previousState  String?  @map("previous_state")
  newState       String?  @map("new_state")
  metadata       Json?
  timestamp      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  record       Record       @relation(fields: [recordId], references: [id])
  actor        User         @relation(fields: [actorId], references: [id])

  @@index([organizationId])
  @@index([recordId])
  @@map("audit_logs")
}

model RiskCategory {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("risk_categories")
}

model ApiKey {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  createdById    String    @map("created_by_id") @db.Uuid
  name           String
  keyHash        String    @unique @map("key_hash")
  keyPrefix      String    @map("key_prefix")
  lastUsedAt     DateTime? @map("last_used_at")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([organizationId])
  @@map("api_keys")
}
